{
  "name": "dev-3bdulrahman/sales",
  "description": "A Sales module for Laravel ERP \u2014 quotations, sales orders, invoices, payments, returns & commissions.",
  "type": "library",
  "version": "1.0.4",
  "license": "MIT",
  "authors": [
    {
      "name": "Abdulrahman",
      "homepage": "https://3bdulrahman.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2|^8.3",
    "laravel/framework": "^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Dev3bdulrahman\\Sales\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Dev3bdulrahman\\Sales\\SalesServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
